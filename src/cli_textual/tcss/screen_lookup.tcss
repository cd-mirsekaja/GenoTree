Screen {
	layers: sidebar;
}

Sidebar#options-sidebar {
	width: 30;
	/* Needs to go in its own layer to sit above content */
	layer: sidebar; 
	/* Dock the sidebar to the appropriate side */
	dock: right;
	/* Offset x to be 100% to move it out of view by default */
	offset-x: 100%;

	background: $surface;
	border-right: vkey $background;    

	/* Enable animation */
	transition: offset 200ms;
	
	&.-visible {
		/* Set offset.x to 0 to make it visible when class is applied */
		offset-x: 0;
	}

	& > Vertical {
		margin: 1 2;
	}
}

#input-results {
    width: 99%;
    border: none #696D7D;
}

Input#species-search {
	dock: top;
	margin: 0 0;
    border: heavy #68B0AB;
}

#results-markdown {
	width: 100%;
	height: auto;
}

#results-container {
	background: $surface;
	margin: 0 0 0 0;
	height: 98%;
    border: heavy #68B0AB;
}