#app-grid {
    layout: grid;
    grid-size: 3;  /* three columns */
    grid-columns: 1fr 2fr 1fr;
    grid-rows: 1fr;
}

#left-pane {
    width: 99%;
    height: 98%;
    border: darkolivegreen;
    align: center top;
}

#left-pane-input {
}

#middle-pane {
    width: 99%;
    height: 98%;
    border: darkolivegreen;
}

#right-pane {
    width: 99%;
    height: 98%;
    border: darkolivegreen;
}

#main-pane {
    width: 99%;
    height: 98%;
    border: darkolivegreen;
    align: center top;
}

ProgressBar {
    dock: top;
}
TextArea {
    height: 95%;
}

Checkbox {
    width: 95%;
}

DirectoryTree {
    height: 30%;
    content-align: left top;
}