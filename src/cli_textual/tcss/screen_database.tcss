#search-app-grid {
    layout: grid;
    grid-size: 3;  /* three columns */
    grid-columns: 1fr 2fr 1fr;
    grid-rows: 1fr;
}

#db-app-grid {
    layout: grid;
    grid-size: 2;  /* three columns */
    grid-columns: 2fr 1fr;
    grid-rows: 1fr 3fr;
}

#main-pane {
    width: 99%;
    border: none #696D7D;
    align: center top;
}

#search-left-pane {
    min-width: 50%;
    max-width: 100%;
    border: heavy #68B0AB;
}

#search-middle-pane {
    min-width: 40%;
    max-width: 100%;
    border: heavy #68B0AB;
}

#search-right-pane {
    min-width: 40%;
    max-width: 100%;
    border: heavy #68B0AB;
}

#db-left-pane {
    min-width: 60%;
    max-width: 100%;
    border: heavy #68B0AB;
}

#db-right-pane {
    min-width: 30%;
    max-width: 100%;
    border: heavy #68B0AB;
}

#search-settings-checkboxes {
    align: center top;
    border: none #68B0AB;
    height: 25%;
}

#search-settings-input {
    border: hkey #68B0AB;
    height: 55%;
}

#search-settings-input-tree {
    border: hkey #68B0AB;
    width: 95%;
    height: 50%;
}

#search-settings-run {
    align: center top;
    border: none #68B0AB;
    height: 20%;
}

Input#input-path {
    margin: 0 0;
    border: solid #8FC0A9;
    width: 70%;
}

#button-upload {
    margin: 0 0;
    width: 20%;
    border: round #8FC0A9;
}

DirectoryTree {
    height: 80%;
    width: 100%;
    margin: 0 0;
}

#button-clear-input {
    border: round #8FC0A9;
}

#button-clear-table {
    border: round #8FC0A9;
    background: $surface;
}

#button-parse-input {
    margin: 1 1;
}

#button-submit-input {
    margin: 1 1;
}

TextArea {
    border: none;
}

ProgressBar {
    dock: top;
    width: 98%;
}

RichLog {
    text-wrap: wrap;
}

#db-options-container {
    border: none #68B0AB;
    height: 10%;
}

#db-table-container {
    border: none #68B0AB;
    height: 90%;
}

Select {
    width: 40%;
}

#db-table {
    height: 100%;
}