#app-grid {
    layout: grid;
    grid-size: 2;  /* two columns */
    grid-columns: 2fr 1fr;
    grid-rows: 1fr;
}

#left-pane > Static {
    color: auto;
    margin-bottom: 1;
    padding: 1;
    background: $boost;
}

#left-pane {
    width: 100%;
    height: 100%;
    row-span: 2;
    border: darkolivegreen;
}

#right-pane > Static {
    width: auto;
    height: 100%;
    margin-right: 1;
    background: $boost;
}

#right-pane {
    height: 100%;
    border: darkolivegreen;
}